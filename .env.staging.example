# Staging / production deployment variables
NODE_ENV=production
APP_ORIGIN=https://staging.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inbox9
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Shared serverless rate limiter (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# Session/account configuration

# INBOX9 recharge destination
INBOX9_UPI_ID=

# Maximum simultaneously retained authenticated sessions per user (1-20).
INBOX9_MAX_SESSIONS=5

DATABASE_SSL_CA=
CRON_SECRET=generate-a-long-random-cron-secret
