# Persistent staging / production deployment variables for any Node host
NODE_ENV=production
APP_ORIGIN=https://your-public-host.example
INBOX9_RUNTIME_MODE=postgres

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inbox9
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Shared REST rate limiter (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# Session/account configuration
INBOX9_UPI_ID=
INBOX9_MAX_SESSIONS=5

DATABASE_SSL_CA=
CRON_SECRET=generate-a-long-random-cron-secret

# Keep disabled until a real payment reconciliation flow is intentionally enabled.
INBOX9_ENABLE_RECHARGE=false
