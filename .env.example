# Local/test default. Production must use INBOX9_RUNTIME_MODE=postgres.
NODE_ENV=
INBOX9_RUNTIME_MODE=synthetic

# PostgreSQL (required for production)
DATABASE_URL=
DB_POOL_MAX=5
DATABASE_SSL=true
# Keep TLS certificate verification enabled; use DATABASE_SSL_CA for private/self-signed CAs.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Shared rate limiter (required for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session/account configuration

# Optional NumberOTP authenticated fulfillment adapter. Leave blank for availability-only mode.
NUMBEROTP_API_KEY=

# Recharge destination
INBOX9_UPI_ID=

# Scheduled-job authentication
CRON_SECRET=replace-me-with-a-long-random-cron-secret

# Canonical HTTPS origin used for production same-origin/CSRF checks
APP_ORIGIN=https://your-domain.example

# Maximum simultaneously retained authenticated sessions per user (1-20).
INBOX9_MAX_SESSIONS=5

# Optional PostgreSQL CA certificate for strict TLS server verification.
DATABASE_SSL_CA=

# Production payment toggle; keep false until a real payment reconciliation flow is configured.
INBOX9_ENABLE_RECHARGE=false

# VirtualSMS guarded external-provider readiness (never commit real credentials)
VIRTUALSMS_API_KEY=
VIRTUALSMS_BASE_URL=https://virtualsms.io
VIRTUALSMS_RESELLER_AUTHORIZED=false
VIRTUALSMS_CANARY_ENABLED=false
VIRTUALSMS_ALLOWED_SERVICE_IDS_JSON=[]
VIRTUALSMS_SERVICE_MAP_JSON={}
VIRTUALSMS_PREFLIGHT_ONLY=true
VIRTUALSMS_CANARY_MAX_ALLOCATIONS=30
