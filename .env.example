# Local/test default. Production must use INBOX9_RUNTIME_MODE=postgres.
NODE_ENV=
INBOX9_RUNTIME_MODE=synthetic

# PostgreSQL (required for production)
DATABASE_URL=
DB_POOL_MAX=5
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=

# Shared rate limiter (required for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session/account configuration
INBOX9_MAX_SESSIONS=5

# Recharge destination
INBOX9_UPI_ID=

# Scheduled-job authentication
CRON_SECRET=replace-me-with-a-long-random-cron-secret

# Canonical HTTPS origin used for production same-origin/CSRF checks
APP_ORIGIN=https://your-domain.example

# Manual recharge remains the only enabled customer payment flow.
INBOX9_ENABLE_RECHARGE=false

# Optional authorized SMS-provider adapters.
# Leave unset until the provider account is approved, funded as required,
# and service-code mappings have been verified server-side.
INBOX9_ASMS_API_KEY=
INBOX9_ASMS_BASE_URL=https://asms.ai
INBOX9_ASMS_COUNTRY_MAP_JSON=

INBOX9_PVAPINS_API_KEY=
INBOX9_PVAPINS_BASE_URL=https://api.pvapins.com

INBOX9_SVNUMBER_API_KEY=
INBOX9_SVNUMBER_BASE_URL=https://sms-verification-number.com/stubs/handler_api
