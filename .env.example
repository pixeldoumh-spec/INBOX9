# PostgreSQL (required for persistent mode / production)
DATABASE_URL=
DB_POOL_MAX=5
DATABASE_SSL=true

# Shared serverless rate limiter (required for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session/account configuration
# Reserved for future server-side token signing/keyed hashing.
SESSION_SECRET=replace-me-with-a-long-random-secret

# Recharge destination
INBOX9_UPI_ID=8106204597@ptyes

# Vercel Cron authentication (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-me-with-a-long-random-cron-secret

# Canonical HTTPS origin used for production same-origin/CSRF checks
APP_ORIGIN=https://your-domain.example

# Optional provider adapter (server-side only; use only authorized APIs)
PROVIDER_API_BASE_URL=
PROVIDER_API_KEY=

# Maximum simultaneously retained authenticated sessions per user (1-20).
INBOX9_MAX_SESSIONS=5

# Optional PostgreSQL CA certificate for strict TLS server verification.
# Leave empty for managed providers that require rejectUnauthorized=false.
DATABASE_SSL_CA=

# Shelex public SMS-testing adapter: diagnostics only; never route paid activations to it.
SHELEX_TEST_BASE_URL=https://otp-api.shelex.dev/api
